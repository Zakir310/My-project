{
	// ---------- Design : noir minimaliste (couleurs du portfolio) ----------
	// Base intégrée à VS Code + couleurs perso : rien à installer.
	// Palette : fond #04060B, texte #E6EAF2, accent #3B6BFF, bordures #141A2B
	"workbench.colorTheme": "Default Dark Modern",
	"workbench.iconTheme": "symbols",
	"workbench.productIconTheme": "Default",
	"editor.fontFamily": "'Geist Mono', 'JetBrains Mono', Menlo, monospace",
	"editor.fontLigatures": false,
	"editor.fontSize": 14,
	"editor.fontWeight": "400",
	"editor.lineHeight": 1.7,
	"editor.letterSpacing": 0.2,
	"terminal.integrated.fontFamily": "'Geist Mono', 'JetBrains Mono', Menlo, monospace",
	"terminal.integrated.fontSize": 13,
	"terminal.integrated.lineHeight": 1.2,
	"terminal.integrated.cursorStyle": "line",
	"editor.cursorBlinking": "smooth",
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.cursorWidth": 2,
	"editor.smoothScrolling": true,
	"workbench.list.smoothScrolling": true,
	"editor.padding.top": 16,
	"editor.bracketPairColorization.enabled": false,
	"editor.guides.bracketPairs": false,
	"editor.guides.indentation": true,
	"editor.renderLineHighlight": "line",
	"editor.renderWhitespace": "trailing",
	"editor.stickyScroll.enabled": false,
	"editor.hideCursorInOverviewRuler": true,
	"editor.overviewRulerBorder": false,
	"editor.scrollbar.verticalScrollbarSize": 6,
	"editor.scrollbar.horizontalScrollbarSize": 6,
	"editor.occurrencesHighlight": "off",
	"workbench.activityBar.location": "top",
	"workbench.layoutControl.enabled": false,
	"workbench.tree.indent": 14,
	"workbench.tree.renderIndentGuides": "none",
	"window.commandCenter": true,
	"breadcrumbs.enabled": false,
	"workbench.colorCustomizations": {
		"[Default Dark Modern]": {
			"foreground": "#E6EAF2",
			"descriptionForeground": "#8A93A8",
			"focusBorder": "#3B6BFF66",
			"contrastBorder": "#00000000",
			"widget.border": "#141A2B",
			"widget.shadow": "#00000080",
			"selection.background": "#3B6BFF55",
			"icon.foreground": "#8A93A8",
			"textLink.foreground": "#6E8BFF",

			"editor.background": "#04060B",
			"editor.foreground": "#E6EAF2",
			"editorLineNumber.foreground": "#2A3247",
			"editorLineNumber.activeForeground": "#8A93A8",
			"editorCursor.foreground": "#3B6BFF",
			"editor.lineHighlightBackground": "#0A0E18",
			"editor.lineHighlightBorder": "#00000000",
			"editor.selectionBackground": "#3B6BFF40",
			"editor.inactiveSelectionBackground": "#3B6BFF20",
			"editor.findMatchBackground": "#3B6BFF60",
			"editor.findMatchHighlightBackground": "#3B6BFF25",
			"editor.wordHighlightBackground": "#3B6BFF18",
			"editorIndentGuide.background1": "#0F1422",
			"editorIndentGuide.activeBackground1": "#26304D",
			"editorWhitespace.foreground": "#FF5C5C80",
			"editorRuler.foreground": "#141A2B",
			"editorGutter.background": "#04060B",
			"editorWidget.background": "#070A12",
			"editorWidget.border": "#141A2B",
			"editorSuggestWidget.background": "#070A12",
			"editorSuggestWidget.border": "#141A2B",
			"editorSuggestWidget.selectedBackground": "#3B6BFF30",
			"editorHoverWidget.background": "#070A12",
			"editorHoverWidget.border": "#141A2B",
			"editorError.foreground": "#FF5C5C",
			"editorWarning.foreground": "#E8B04A",
			"editorOverviewRuler.border": "#00000000",
			"editorGroupHeader.tabsBackground": "#04060B",
			"editorGroupHeader.tabsBorder": "#00000000",
			"editorGroup.border": "#141A2B",

			"tab.activeBackground": "#04060B",
			"tab.inactiveBackground": "#04060B",
			"tab.activeForeground": "#F2F5FC",
			"tab.inactiveForeground": "#4B5468",
			"tab.border": "#00000000",
			"tab.activeBorder": "#00000000",
			"tab.activeBorderTop": "#3B6BFF",
			"tab.hoverBackground": "#070A12",

			"titleBar.activeBackground": "#04060B",
			"titleBar.inactiveBackground": "#04060B",
			"titleBar.activeForeground": "#8A93A8",
			"titleBar.border": "#141A2B",
			"commandCenter.background": "#070A12",
			"commandCenter.border": "#141A2B",

			"activityBar.background": "#04060B",
			"activityBar.foreground": "#E6EAF2",
			"activityBar.inactiveForeground": "#4B5468",
			"activityBar.border": "#141A2B",
			"activityBar.activeBorder": "#3B6BFF",
			"activityBarBadge.background": "#3B6BFF",
			"activityBarBadge.foreground": "#FFFFFF",
			"activityBarTop.foreground": "#E6EAF2",
			"activityBarTop.inactiveForeground": "#4B5468",
			"activityBarTop.activeBorder": "#3B6BFF",

			"sideBar.background": "#04060B",
			"sideBar.foreground": "#8A93A8",
