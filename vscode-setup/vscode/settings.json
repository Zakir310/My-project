			"statusBar.debuggingBackground": "#3B6BFF",
			"statusBar.debuggingForeground": "#FFFFFF",
			"statusBarItem.remoteBackground": "#04060B",
			"statusBarItem.remoteForeground": "#3B6BFF",

			"input.background": "#070A12",
			"input.border": "#141A2B",
			"input.placeholderForeground": "#4B5468",
			"dropdown.background": "#070A12",
			"dropdown.border": "#141A2B",
			"button.background": "#3B6BFF",
