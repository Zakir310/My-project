			"list.activeSelectionBackground": "#3B6BFF26",
			"list.activeSelectionForeground": "#F2F5FC",
			"list.inactiveSelectionBackground": "#0B1020",
			"list.hoverBackground": "#0A0E18",
			"list.focusOutline": "#00000000",
			"list.highlightForeground": "#3B6BFF",

			"panel.background": "#04060B",
			"panel.border": "#141A2B",
