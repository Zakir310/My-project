{
	// ---------- Design ----------
	// Autres thèmes installés : "Catppuccin Mocha", "GitHub Dark Default",
	// "One Dark Pro". Pour changer : Cmd+K puis Cmd+T.
	"workbench.colorTheme": "Tokyo Night",
	"editor.fontFamily": "'JetBrains Mono', Menlo, Monaco, 'Courier New', monospace",
	"editor.fontLigatures": true,
	"editor.fontSize": 14,
	"editor.lineHeight": 1.6,
	"terminal.integrated.fontFamily": "'JetBrains Mono', Menlo, monospace",
	"terminal.integrated.fontSize": 13,
	"editor.cursorBlinking": "smooth",
	"editor.cursorSmoothCaretAnimation": "on",
	"editor.cursorStyle": "line",
	"editor.smoothScrolling": true,
	"workbench.list.smoothScrolling": true,
	"editor.guides.bracketPairs": "active",
	"editor.renderLineHighlight": "all",
	"editor.padding.top": 12,
	"window.commandCenter": true,
	"workbench.tree.indent": 14,
	"workbench.layoutControl.enabled": false,
	"breadcrumbs.enabled": true,
	// Petits accents au bleu de ton portfolio (#3B6BFF)
	"workbench.colorCustomizations": {
		"[Tokyo Night]": {
			"editorCursor.foreground": "#3B6BFF",
			"activityBarBadge.background": "#3B6BFF",
			"statusBarItem.remoteBackground": "#3B6BFF",
			"focusBorder": "#3B6BFF80",
			"editorRuler.foreground": "#26304D"
		}
	},

	// ---------- Éditeur ----------
	"editor.rulers": [80],
	"editor.renderWhitespace": "boundary",
	"editor.minimap.enabled": false,
	"editor.bracketPairColorization.enabled": true,
	"editor.formatOnSave": false,
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"files.eol": "\n",
	"files.autoSave": "onFocusChange",

	// ---------- C (style Betty : tabulations de 8) ----------
	"[c]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 8,
		"editor.detectIndentation": false,
		"editor.defaultFormatter": "ms-vscode.cpptools"
	},
	"[cpp]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 8
	},
	"C_Cpp.default.cStandard": "gnu89",
	// Remplacé par install.sh (sur Mac : le gcc de Homebrew)
	"C_Cpp.default.compilerPath": "/usr/bin/gcc",
	"C_Cpp.clang_format_style": "file",
	"C_Cpp.clang_format_fallbackStyle": "LLVM",
	"files.associations": {
		"*.h": "c"
	},

	// ---------- Shell ----------
	"[shellscript]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 8,
		"editor.defaultFormatter": "foxundermoon.shell-format"
	},
	"shellcheck.enable": true,
	"shellcheck.run": "onType",

	// ---------- Terminal intégré ----------
	"terminal.integrated.defaultProfile.linux": "bash",
	"terminal.integrated.defaultProfile.osx": "zsh",
	// Sur Mac : Option sert de touche Meta (M-x, M-f...) dans le terminal
	"terminal.integrated.macOptionIsMeta": true,
	"terminal.integrated.scrollback": 10000,
	"terminal.integrated.copyOnSelection": true,

	// ---------- Git ----------
	"git.autofetch": true,
	"git.confirmSync": false,
	"git.enableSmartCommit": true,
	"git.pruneOnFetch": true,

	// ---------- Markdown / README ----------
	"[markdown]": {
		"editor.wordWrap": "on",
		"files.trimTrailingWhitespace": false
	},
	"cSpell.language": "en,fr",

	// ---------- Emacs keymap ----------
	// L'extension emacs-mcx active les raccourcis Emacs (C-x C-s, C-a, C-e,
	// C-k, C-y...). Pour revenir aux raccourcis classiques : désactive-la.
	"emacs-mcx.killRingMax": 60,

	// ---------- Code Runner (bouton ▶ en haut à droite) ----------
	"code-runner.executorMap": {
		"c": "cd $dir && gcc -Wall -Werror -Wextra -pedantic -std=gnu89 *.c -o a.out && ./a.out",
		"shellscript": "bash",
		"python": "python3 -u"
	},
	"code-runner.runInTerminal": true,
	"code-runner.saveFileBeforeRun": true,
	"code-runner.clearPreviousOutput": true,

	// ---------- Python (style pycodestyle exigé à Holberton) ----------
	"[python]": {
		"editor.rulers": [79],
		"editor.insertSpaces": true,
		"editor.tabSize": 4,
		"editor.defaultFormatter": "ms-python.autopep8"
	},

	// ---------- Web ----------
	"[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

	// ---------- Apparence ----------
	"workbench.iconTheme": "material-icon-theme",
	"todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK"],

	// ---------- Divers ----------
	"workbench.startupEditor": "none",
	"explorer.confirmDragAndDrop": false
}
