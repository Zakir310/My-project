			"button.hoverBackground": "#5580FF",
			"badge.background": "#3B6BFF",
			"badge.foreground": "#FFFFFF",
			"scrollbarSlider.background": "#26304D55",
			"scrollbarSlider.hoverBackground": "#26304D99",
			"scrollbarSlider.activeBackground": "#3B6BFF80",
			"quickInput.background": "#070A12",
			"quickInputList.focusBackground": "#3B6BFF30",
			"menu.background": "#070A12",
			"menu.border": "#141A2B",
			"menu.selectionBackground": "#3B6BFF30",
			"notifications.background": "#070A12",
			"notifications.border": "#141A2B",
			"breadcrumb.background": "#04060B",
			"gitDecoration.modifiedResourceForeground": "#6E8BFF",
			"gitDecoration.untrackedResourceForeground": "#7FD1AE",
			"gitDecoration.deletedResourceForeground": "#FF5C5C"
		}
	},
	// Coloration du code : peu de couleurs, le bleu pour les mots-clés
	"editor.semanticTokenColorCustomizations": {
		"[Default Dark Modern]": { "enabled": false }
	},
	"editor.tokenColorCustomizations": {
		"[Default Dark Modern]": {
			"comments": "#4B5468",
			"keywords": "#3B6BFF",
			"storage": "#3B6BFF",
			"types": "#9DB4FF",
			"functions": "#F2F5FC",
			"variables": "#E6EAF2",
			"strings": "#A8B3C7",
			"numbers": "#9DB4FF",
			"textMateRules": [
				{ "scope": "comment", "settings": { "fontStyle": "italic" } },
				{ "scope": ["keyword.control.directive", "meta.preprocessor", "keyword.control.import", "punctuation.definition.directive"], "settings": { "foreground": "#6E8BFF" } },
				{ "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#8A93A8" } },
				{ "scope": ["constant.character.escape", "constant.other.placeholder"], "settings": { "foreground": "#6E8BFF" } },
				{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#F2F5FC", "fontStyle": "" } },
				{ "scope": ["constant.language", "support.constant"], "settings": { "foreground": "#9DB4FF" } },
				{ "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#3B6BFF", "fontStyle": "bold" } }
			]
		}
	},

	// ---------- Éditeur ----------
	"editor.rulers": [80],
	"editor.minimap.enabled": false,
	"editor.formatOnSave": false,
	"files.trimTrailingWhitespace": true,
	"files.insertFinalNewline": true,
	"files.trimFinalNewlines": true,
	"files.eol": "\n",
	"files.autoSave": "onFocusChange",

	// ---------- C (style Betty : tabulations de 8) ----------
	"[c]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 8,
		"editor.detectIndentation": false,
		"editor.defaultFormatter": "ms-vscode.cpptools"
	},
	"[cpp]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 8
	},
	"C_Cpp.default.cStandard": "gnu89",
	// Remplacé par install.sh (sur Mac : le gcc de Homebrew)
	"C_Cpp.default.compilerPath": "/usr/bin/gcc",
	"C_Cpp.clang_format_style": "file",
	"C_Cpp.clang_format_fallbackStyle": "LLVM",
	"files.associations": {
		"*.h": "c"
	},

	// ---------- Shell ----------
	"[shellscript]": {
		"editor.insertSpaces": false,
		"editor.tabSize": 8,
		"editor.defaultFormatter": "foxundermoon.shell-format"
	},
	"shellcheck.enable": true,
	"shellcheck.run": "onType",

	// ---------- Terminal intégré ----------
	"terminal.integrated.defaultProfile.linux": "bash",
	"terminal.integrated.defaultProfile.osx": "zsh",
	// Sur Mac : Option sert de touche Meta (M-x, M-f...) dans le terminal
	"terminal.integrated.macOptionIsMeta": true,
	"terminal.integrated.scrollback": 10000,
	"terminal.integrated.copyOnSelection": true,

	// ---------- Git ----------
	"git.autofetch": true,
	"git.confirmSync": false,
	"git.enableSmartCommit": true,
	"git.pruneOnFetch": true,

	// ---------- Markdown / README ----------
	"[markdown]": {
		"editor.wordWrap": "on",
		"files.trimTrailingWhitespace": false
	},
	"cSpell.language": "en,fr",

	// ---------- Emacs keymap ----------
	// L'extension emacs-mcx active les raccourcis Emacs (C-x C-s, C-a, C-e,
	// C-k, C-y...). Pour revenir aux raccourcis classiques : désactive-la.
	"emacs-mcx.killRingMax": 60,

	// ---------- Code Runner (bouton ▶ en haut à droite) ----------
	"code-runner.executorMap": {
		"c": "cd $dir && gcc -Wall -Werror -Wextra -pedantic -std=gnu89 *.c -o a.out && ./a.out",
		"shellscript": "bash",
		"python": "python3 -u"
	},
	"code-runner.runInTerminal": true,
	"code-runner.saveFileBeforeRun": true,
	"code-runner.clearPreviousOutput": true,

	// ---------- Python (style pycodestyle exigé à Holberton) ----------
	"[python]": {
		"editor.rulers": [79],
		"editor.insertSpaces": true,
		"editor.tabSize": 4,
		"editor.defaultFormatter": "ms-python.autopep8"
	},

	// ---------- Web ----------
	"[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
	"[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

	"todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK"],

	// ---------- Autocomplétion IA (GitHub Copilot) ----------
	// Suggestion grise : Tab = accepter, Échap = refuser,
	// Option+] / Option+[ = suggestion suivante / précédente.
	// Pour couper : clic sur l'icône Copilot dans la barre du bas.
	"editor.inlineSuggest.enabled": true,
	"github.copilot.enable": {
		"*": true,
		"plaintext": false
	},

	// ---------- Divers ----------
	"workbench.startupEditor": "none",
	"explorer.confirmDragAndDrop": false
}
