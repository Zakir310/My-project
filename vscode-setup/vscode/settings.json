			"panelTitle.activeBorder": "#3B6BFF",
			"terminal.background": "#04060B",
			"terminal.foreground": "#E6EAF2",
			"terminalCursor.foreground": "#3B6BFF",
			"terminal.ansiBlue": "#3B6BFF",
			"terminal.ansiBrightBlue": "#6E8BFF",

			"statusBar.background": "#04060B",
			"statusBar.foreground": "#4B5468",
			"statusBar.border": "#141A2B",
