# Inclus dans ~/.gitconfig par install.sh (via [include]).
[init]
	defaultBranch = main
[core]
	editor = code --wait
	autocrlf = input
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[color]
	ui = auto
[alias]
	st = status -sb
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate --all
	last = log -1 HEAD --stat
	undo = reset --soft HEAD~1
